SECRET_KEY=generate-with-python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# Where backup.py writes the nightly database snapshot and the mirrored
# copy of uploaded documents. Leave blank to use ./backups, but that puts
# the backups on the SAME DISK as the live data — which protects against a
# bad deletion, not against the disk or machine failing. Point this at
# somewhere off this machine: a mounted network share, a synced cloud
# folder, or a second physical disk.
#   BACKUP_DIR=D:/palsu_gate_backups
#   BACKUP_DIR=/mnt/backups/palsu_gate
BACKUP_DIR=
# Only needed if the browser reaches this server over a different
# scheme/host than Django sees directly — a Cloudflare Tunnel/ngrok URL
# during testing, or any reverse proxy/CDN terminating TLS in front of
# Django in production. Each entry needs the scheme, e.g.:
# CSRF_TRUSTED_ORIGINS=https://your-tunnel-name.trycloudflare.com
CSRF_TRUSTED_ORIGINS=https://merchandise-witch-measured-paint.trycloudflare.com 
HTTPS_ENABLED=False
TRUST_X_FORWARDED_FOR=False
API_KEYS=generate-a-random-key-per-gate-with-python -c "import secrets; print(secrets.token_urlsafe(32))"

# Root secret for NTAG215 tag passwords. Each tag is locked with a 4-byte
# PWD_AUTH password derived as HMAC-SHA256(RFID_MASTER_KEY, uid) — see
# api/rfid_auth.py. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# NEVER CHANGE THIS ONCE TAGS HAVE BEEN ISSUED. Every tag in circulation is
# physically locked with a password computed from this value. Changing it
# does not re-key those tags — it strands them: the server computes
# passwords the tags reject, and the tags stay locked with a password
# nothing can recompute. Recovery means collecting every tag. Treat this
# like the SECRET_KEY, not like an API key.
#
# This must also be a DIFFERENT value from API_KEYS. API keys live on gate
# devices and are meant to be reflashed; this one stays on the server only.
RFID_MASTER_KEY=generate-with-python -c "import secrets; print(secrets.token_urlsafe(32))"

# Outbound email: sign-up codes, password reset links, and applicant status
# notices (appointment scheduled, approved, rejected, sticker issued). The
# console backend just prints them to the server log — fine until real SMTP
# is set up. To send real email, switch EMAIL_BACKEND below and fill in the
# EMAIL_HOST_* values (e.g. a university mail relay or a transactional email
# provider).
#
# Note that with the console backend, password recovery does not work for
# anyone who cannot read the server log: the reset link is printed, not
# delivered. Real SMTP is required before the portal is usable by staff and
# applicants who have forgotten a password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Send as the university's own domain. Mail that asks somebody to click a
# link and set a password gets treated as phishing — correctly — when it
# arrives from somewhere unrelated to the institution. Both of these must be
# mailboxes the campus relay will actually send as, and SUPPORT_EMAIL must be
# one a person reads: it is the only route back for staff with no address on
# file and for applicants locked out of their campus mailbox.
DEFAULT_FROM_EMAIL=PalawanSU Gate System <noreply@psu.palawan.edu.ph>
SUPPORT_EMAIL=gate-support@psu.palawan.edu.ph

# How long a password reset link stays valid, in seconds. Django's own
# default is three days; one hour is plenty and leaves a much smaller window
# for a link sitting in a mailbox somebody else can read.
PASSWORD_RESET_TIMEOUT=3600

# Applicant self-registration. Only addresses at this domain may sign up,
# and the account stays inactive until the emailed one-time code is
# confirmed. With the console email backend above, the code is printed to
# the server log instead of being delivered — fine for local testing, but
# real SMTP is required before this is useful in production.
REGISTRATION_EMAIL_DOMAIN=psu.palawan.edu.ph
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
